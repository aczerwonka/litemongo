{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=3001 npx concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"PORT=5173 npm run dev:client\""
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 3001
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "port": 5173
    }
  ]
}