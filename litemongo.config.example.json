  "relationBlueprints": [
    {
      "id": "policy-claims-hierarchy",
      "name": "Policy -> Claims -> Claim Items (3-Level)",
      "rootCollection": "policies",
      "levels": [
        {
          "level": 2,
          "collection": "claims",
          "localField": "_id",
          "foreignField": "policyId",
          "displayBadgeField": "claimNumber"
        },
        {
          "level": 3,
          "collection": "claim_items",
          "parentCollection": "claims",
          "localField": "_id",
          "foreignField": "claimId",
          "displayBadgeField": "code"
        }
      ]
    },
    {
      "id": "policies2-parties-claims",
      "name": "Policies2 -> Contractors -> Persons, Policies2 -> Claims2",
      "rootCollection": "policies2",
      "levels": [
        {
          "level": 2,
          "collection": "contractors",
          "parentCollection": "policies2",
          "localField": "contractors.contractorId",
          "foreignField": "_id",
          "displayBadgeField": "contractorCode"
        },
        {
          "level": 3,
          "collection": "persons",
          "parentCollection": "contractors",
          "localField": "persons.personId",
          "foreignField": "_id",
          "displayBadgeField": "personCode"
        },
        {
          "level": 2,
          "collection": "claims2",
          "parentCollection": "policies2",
          "localField": "_id",
          "foreignField": "policyId",
          "displayBadgeField": "claimNumber"
        }
      ]
    }
  ],
  "queryPresets": [
    {
      "id": "active-policies-young-driver",
      "name": "Active Policies with Young Driver Loading",
      "collection": "policies",
      "filter": {
        "status": "ACTIVE",
        "covers": {
          "$elemMatch": {
            "loadings.code": "LOAD_YOUNG_DRIVER"
          }
        }
      },
      "projection": {
        "policyNumber": 1,
        "productCode": 1,
        "status": 1,
        "totalPremium": 1,
        "covers.coverId": 1,
        "covers.code": 1,
        "covers.loadings": 1
      },
      "limit": 100,
      "relationBlueprintId": "policy-claims-hierarchy"
    },
    {
      "id": "open-claims",
      "name": "Open & Investigating Claims",
      "collection": "claims",
      "filter": {
        "status": {
          "$in": [
            "OPEN",
            "INVESTIGATING"
          ]
        }
      },
      "projection": {},
      "limit": 100
    },
    {
      "id": "policies2-ac-with-young-driver",
      "name": "Policies2: AC cover with young-driver loading",
      "collection": "policies2",
      "filter": {
        "status": "ACTIVE",
        "covers": {
          "$elemMatch": {
            "code": "COVER_AC",
            "loadings.code": "LOAD_YOUNG_DRIVER"
          }
        }
      },
      "limit": 100,
      "relationBlueprintId": "policies2-parties-claims"
    },
    {
      "id": "persons-high-income",
      "name": "Persons: decimal attribute MONTHLY_INCOME > 15000",
      "collection": "persons",
      "filter": {
        "attributes": {
          "$elemMatch": {
            "code": "MONTHLY_INCOME",
            "value": {
              "$gt": {
                "$numberDecimal": "15000"
              }
            }
          }
        }
      },
      "limit": 100
    }
  ],
  "renumberingRules": {
    "policies": {
      "policyNumber": {
        "strategy": "SUFFIX_TIMESTAMP",
        "prefix": "POL-LOCAL-"
      },
      "covers[].coverId": {
        "strategy": "UUID_SHORT",
        "prefix": "COV-"
      }
    },
    "claims": {
      "claimNumber": {
        "strategy": "SUFFIX_TIMESTAMP",
        "prefix": "CLM-LOCAL-"
      }
    }
  }
}
